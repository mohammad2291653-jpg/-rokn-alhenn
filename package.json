{
  "name": "rokn-alhenna",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:preview": "tsx scripts/preflight.ts --preview",
    "brand:import": "tsx scripts/import-brand-logo.ts",
    "brand:prepare": "node scripts/prepare-transparent-logo.mjs",
    "media:import": "tsx scripts/import-product-media.ts",
    "media:prepare": "node scripts/prepare-product-media.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.6.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
