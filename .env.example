# Copy to .env, use a durable managed PostgreSQL database in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rokn?schema=public
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set only while bootstrapping an administrator; never commit credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# S3-compatible private write credentials; publicly readable product media only.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# local storage allowed only in development; use permanent S3 object storage in production.
# No analytics identifiers are set or active by default.
# Set true only after explicit owner launch approval; false for all previews.
COMMERCIAL_LAUNCH_APPROVED=false
ALLOW_INDEXING=false
# Use only behind a trusted proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
# Optional separate encryption secret for order tracking tokens; keep stable/backed up.
ORDER_TOKEN_SECRET=
# Dedicated Render FREE read-only preview only. Never enable against a sales database.
RENDER_FREE_PREVIEW=false
FREE_PREVIEW_DATABASE_NAME=
# Generate a random 48-byte base64url secret; never commit the actual access link.
PREVIEW_ACCESS_TOKEN=
